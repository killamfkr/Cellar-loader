<?xml version="1.0"?>
<Container version="2">
  <Name>ollama-cursor-agent</Name>
  <Repository>ghcr.io/killamfkr/ollama-cursor-agent:latest</Repository>
  <Registry>https://github.com/killamfkr/ollama-cursor-agent/pkgs/container/ollama-cursor-agent</Registry>
  <Network>ollama-agent</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/killamfkr/ollama-cursor-agent/issues</Support>
  <Project>https://github.com/killamfkr/ollama-cursor-agent</Project>
  <Overview>Local Cursor-style coding agent: chat UI, file tools, shell, and GitHub PR workflow — powered by Ollama on your Unraid box.[br][br]Requires [b]ollama[/b] on the same Docker network [b]ollama-agent[/b]. Install [b]Ollama (Cursor Agent stack)[/b] template first, or run the one-script setup.[br][br]Clone your git repo into the Workspace path, set GitHub token/repo for issue automation.</Overview>
  <Category>AI:Productivity</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/killamfkr/ollama-cursor-agent/main/unraid/templates/my-ollama-cursor-agent.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/killamfkr/ollama-cursor-agent/main/unraid/icon.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="Agent WebUI" Target="8080" Default="8080" Mode="tcp" Description="Web UI and REST API" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Workspace (git repo)" Target="/workspace" Default="/mnt/user/appdata/ollama-cursor-agent/workspace" Mode="rw" Description="Git clone the agent edits (mount your project here)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ollama-cursor-agent/workspace</Config>
  <Config Name="Agent data" Target="/data" Default="/mnt/user/appdata/ollama-cursor-agent/agent-data" Mode="rw" Description="Optional agent persistence" Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/ollama-cursor-agent/agent-data</Config>
  <Config Name="Ollama URL" Target="AGENT_OLLAMA_BASE_URL" Default="http://ollama:11434" Mode="" Description="Ollama API base URL" Type="Variable" Display="always" Required="true" Mask="false">http://ollama:11434</Config>
  <Config Name="Default model" Target="AGENT_DEFAULT_MODEL" Default="qwen2.5-coder:7b" Mode="" Description="Ollama model name" Type="Variable" Display="always" Required="false" Mask="false">qwen2.5-coder:7b</Config>
  <Config Name="Max agent steps" Target="AGENT_MAX_AGENT_STEPS" Default="40" Mode="" Description="Tool loop limit per task" Type="Variable" Display="advanced" Required="false" Mask="false">40</Config>
  <Config Name="GitHub token" Target="AGENT_GITHUB_TOKEN" Default="" Mode="" Description="PAT for push/PR (repo + issues scope)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="GitHub repo" Target="AGENT_GITHUB_REPO" Default="killamfkr/ollama-cursor-agent" Mode="" Description="owner/name for issues and PRs" Type="Variable" Display="always" Required="false" Mask="false">killamfkr/ollama-cursor-agent</Config>
  <Config Name="Default branch" Target="AGENT_GITHUB_DEFAULT_BRANCH" Default="main" Mode="" Description="PR base branch" Type="Variable" Display="advanced" Required="false" Mask="false">main</Config>
  <Config Name="Webhook secret" Target="AGENT_GITHUB_WEBHOOK_SECRET" Default="" Mode="" Description="GitHub webhook HMAC secret" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Trigger label" Target="AGENT_GITHUB_TRIGGER_LABEL" Default="agent" Mode="" Description="Issue label that starts the agent" Type="Variable" Display="advanced" Required="false" Mask="false">agent</Config>
  <Config Name="Comment trigger" Target="AGENT_GITHUB_COMMENT_TRIGGER" Default="@agent" Mode="" Description="Phrase in issue comments" Type="Variable" Display="advanced" Required="false" Mask="false">@agent</Config>
  <Config Name="Public URL" Target="AGENT_PUBLIC_BASE_URL" Default="" Mode="" Description="HTTPS URL for webhooks (if exposed)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
