<?xml version="1.0"?>
<Container version="2">
  <Name>ollama-cursor-agent</Name>
  <Repository>ghcr.io/killamfkr/ollama-cursor-agent:latest</Repository>
  <Registry>https://github.com/killamfkr/ollama-cursor-agent/pkgs/container/ollama-cursor-agent</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/killamfkr/ollama-cursor-agent/tree/main/unraid</Support>
  <Project>https://github.com/killamfkr/ollama-cursor-agent</Project>
  <Overview>Local Cursor-style coding agent: chat UI, file tools, shell, and optional GitHub branch/PR workflow — powered by Ollama on your Unraid box.[br][br]1. Install [b]ollama[/b] (this repo template or Community Applications) and pull a coding model.[br]2. Set [b]Ollama Base URL[/b] to [b]http://YOUR-UNRAID-IP:11434[/b] (same port as your Ollama container).[br]3. Mount [b]Workspace[/b] to the git repo the agent should edit.[br][br]Open the Web UI, pick a model, and describe a task. See INSTALL.md in the repo for GitHub webhooks.</Overview>
  <Category>Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/killamfkr/ollama-cursor-agent/main/unraid/ollama-cursor-agent.xml</TemplateURL>
  <Icon>https://ollama.com/public/apple-touch-icon.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <Date>2026-11-07</Date>
  <Changes>Initial Unraid template for Ollama Cursor Agent.</Changes>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="Agent API and browser UI" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Workspace" Target="/workspace" Default="/mnt/user/appdata/ollama-cursor-agent/workspace" Mode="rw" Description="Host folder mounted as the agent sandbox (use a git clone of your project)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ollama-cursor-agent/workspace</Config>
  <Config Name="Ollama Base URL" Target="AGENT_OLLAMA_BASE_URL" Default="http://192.168.1.100:11434" Mode="" Description="Ollama API URL reachable from this container (usually http://UNRAID-IP:11434)" Type="Variable" Display="always" Required="true" Mask="false">http://192.168.1.100:11434</Config>
  <Config Name="Default Model" Target="AGENT_DEFAULT_MODEL" Default="qwen2.5-coder:7b" Mode="" Description="Ollama model name (must be pulled in the Ollama container first)" Type="Variable" Display="always" Required="true" Mask="false">qwen2.5-coder:7b</Config>
  <Config Name="Max Agent Steps" Target="AGENT_MAX_AGENT_STEPS" Default="40" Mode="" Description="Max LLM/tool turns per message" Type="Variable" Display="advanced" Required="false" Mask="false">40</Config>
  <Config Name="Shell Timeout (sec)" Target="AGENT_SHELL_TIMEOUT_SEC" Default="120" Mode="" Description="Timeout for run_shell tool" Type="Variable" Display="advanced" Required="false" Mask="false">120</Config>
  <Config Name="GitHub Token" Target="AGENT_GITHUB_TOKEN" Default="" Mode="" Description="PAT with repo scope (optional — for PR workflow)" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="GitHub Repo" Target="AGENT_GITHUB_REPO" Default="" Mode="" Description="owner/name for GitHub workflow (optional)" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="GitHub Default Branch" Target="AGENT_GITHUB_DEFAULT_BRANCH" Default="main" Mode="" Description="Base branch for agent branches" Type="Variable" Display="advanced" Required="false" Mask="false">main</Config>
  <Config Name="GitHub Branch Prefix" Target="AGENT_GITHUB_BRANCH_PREFIX" Default="cursor/" Mode="" Description="Prefix for agent feature branches" Type="Variable" Display="advanced" Required="false" Mask="false">cursor/</Config>
  <Config Name="GitHub Branch Suffix" Target="AGENT_GITHUB_BRANCH_SUFFIX" Default="local" Mode="" Description="Suffix for agent feature branches" Type="Variable" Display="advanced" Required="false" Mask="false">local</Config>
  <Config Name="GitHub Webhook Secret" Target="AGENT_GITHUB_WEBHOOK_SECRET" Default="" Mode="" Description="Secret for repo webhook → /api/github/webhook" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="GitHub Trigger Label" Target="AGENT_GITHUB_TRIGGER_LABEL" Default="agent" Mode="" Description="Issue label that starts the agent" Type="Variable" Display="advanced" Required="false" Mask="false">agent</Config>
  <Config Name="GitHub Comment Trigger" Target="AGENT_GITHUB_COMMENT_TRIGGER" Default="@agent" Mode="" Description="Issue comment that starts the agent" Type="Variable" Display="advanced" Required="false" Mask="false">@agent</Config>
  <Config Name="Public Base URL" Target="AGENT_PUBLIC_BASE_URL" Default="" Mode="" Description="Public URL for webhook docs (e.g. https://agent.example.com)" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
</Container>
