# Host port for the web UI + API
AGENT_PORT=8080

# Default model (pull via UI or: docker exec ollama ollama pull qwen2.5-coder:7b)
AGENT_DEFAULT_MODEL=qwen2.5-coder:7b

# Directory on the host mounted as the agent workspace
AGENT_WORKSPACE=..

# Max tool+LLM turns per user message
AGENT_MAX_AGENT_STEPS=40

# --- GitHub (Cursor-style branch + PR workflow) ---
# Fine-grained or classic PAT with repo + issues (and pull_requests) scope
GITHUB_TOKEN=
GITHUB_REPO=your-user/your-repo
GITHUB_DEFAULT_BRANCH=main
GITHUB_BRANCH_PREFIX=cursor/
GITHUB_BRANCH_SUFFIX=local

# Webhook (optional): set in repo Settings → Webhooks → https://<host>/api/github/webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_TRIGGER_LABEL=agent
GITHUB_COMMENT_TRIGGER=@agent

# Public URL shown in docs (e.g. https://agent.example.com or ngrok URL)
PUBLIC_BASE_URL=
